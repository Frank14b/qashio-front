# Local development defaults: `cp .env.example .env.local`.
# Validated by lib/env.ts (zod). NEXT_PUBLIC_* values are inlined at build time: restart / rebuild after changing.

# Nest API base URL as seen from the browser (no trailing slash).
# Local `npm run start:dev` and Docker Compose both expose the API on :3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Sentry (off by default). Enabling requires NEXT_PUBLIC_SENTRY_DSN.
NEXT_PUBLIC_SENTRY_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
